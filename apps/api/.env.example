# Copy to .env in apps/api and replace the database password.
# Run Go from apps/api. Existing process environment variables override .env.
HOST=127.0.0.1
PORT=8080
DATABASE_URL=postgres://chat_app:replace_with_app_password@127.0.0.1:5432/chat?sslmode=disable
DATABASE_MAX_CONNS=10
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
# Only for database integration tests; must be a separate dedicated database.
TEST_DATABASE_URL=postgres://chat_app:replace_with_app_password@127.0.0.1:5432/chat_test?sslmode=disable
